<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="format-detection" content="telephone=no, date=no, address=no, email=no, url=no">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{.Subject}}</title>
<style>
body { margin: 0; padding: 0; width: 100%; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
table { border-collapse: collapse; }
a[x-apple-data-detectors] { color: inherit !important; text-decoration: none !important; font-size: inherit !important; font-family: inherit !important; font-weight: inherit !important; line-height: inherit !important; }
@media only screen and (max-width: 600px) {
  .gutter { padding: 24px 12px !important; }
  .inner { padding-left: 24px !important; padding-right: 24px !important; }
  .footer { padding-left: 25px !important; padding-right: 25px !important; }
  .label { width: 92px !important; }
  .headline { font-size: 20px !important; line-height: 28px !important; }
}
</style>
<style>
:root { color-scheme: light dark; supported-color-schemes: light dark; }
@media (prefers-color-scheme: dark) {
  .page { background-color: #0a0a0a !important; }
  .card { background-color: #141414 !important; border-left-color: #262626 !important; border-right-color: #262626 !important; border-bottom-color: #262626 !important; }
  .ink { color: #f5f5f5 !important; }
  .prose { color: #d4d4d4 !important; }
  .muted { color: #a3a3a3 !important; }
  .divider { border-top-color: #242424 !important; }
  .panel { background-color: #0e0e0e !important; border-color: #262626 !important; }
}
</style>
</head>
<body class="page" style="margin:0;padding:0;width:100%;background-color:#f5f5f5;">
<table role="presentation" class="page" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background-color:#f5f5f5;">
  <tr>
    <td class="gutter" align="center" style="padding:48px 16px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:560px;border-collapse:separate;border-spacing:0;">
        <tr>
          <td class="card inner" style="padding:32px 40px 30px;background-color:#ffffff;border:1px solid #e5e5e5;border-top:4px solid {{.Accent}};border-radius:12px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;text-align:left;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
              <tr>
                <td class="ink" style="font-size:11px;line-height:16px;font-weight:600;letter-spacing:3px;color:#171717;">RELAY</td>
              </tr>
              <tr>
                <td style="padding-top:32px;">
                  <h1 class="ink headline" style="margin:0;font-size:22px;line-height:30px;font-weight:600;letter-spacing:-0.2px;color:#171717;"><span style="font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;font-size:0.95em;letter-spacing:0;">{{.App}}</span> {{.Verb}}</h1>
                </td>
              </tr>
              {{- with .Project}}
              <tr>
                <td class="muted" style="padding-top:4px;font-size:14px;line-height:20px;color:#737373;">{{.}}</td>
              </tr>
              {{- end}}
              {{- with .Summary}}
              <tr>
                <td class="prose" style="padding-top:20px;font-size:15px;line-height:24px;color:#404040;">{{.}}</td>
              </tr>
              {{- end}}
              {{- if .Rows}}
              <tr>
                <td style="padding-top:28px;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
                    {{- range .Rows}}
                    <tr>
                      <td class="label muted divider" width="104" valign="top" style="width:104px;padding:10px 16px 10px 0;border-top:1px solid #ededed;font-size:13px;line-height:20px;color:#737373;white-space:nowrap;">{{.Label}}</td>
                      <td class="ink divider" valign="top" style="padding:10px 0;border-top:1px solid #ededed;font-size:14px;line-height:20px;color:#171717;word-break:break-word;overflow-wrap:anywhere;">
                        {{- if .Mono}}<span style="font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;font-size:13px;">{{breakable .Value}}</span>{{else}}{{.Value}}{{end}}
                        {{- with .Note}}<span class="muted" style="color:#737373;">&nbsp;&nbsp;·&nbsp;&nbsp;{{.}}</span>{{end -}}
                      </td>
                    </tr>
                    {{- end}}
                  </table>
                </td>
              </tr>
              {{- end}}
              {{- with .Failure}}
              <tr>
                <td style="padding-top:16px;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:separate;border-spacing:0;">
                    <tr>
                      <td class="panel" style="padding:16px 18px;background-color:#fafafa;border:1px solid #ebebeb;border-radius:8px;font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
                          {{- with .Code}}
                          <tr>
                            <td class="ink" style="font-size:13px;line-height:20px;font-weight:600;color:#171717;">{{.}}</td>
                          </tr>
                          {{- end}}
                          {{- with .Message}}
                          <tr>
                            <td class="prose" style="padding-top:8px;font-size:12px;line-height:19px;color:#404040;white-space:pre-wrap;word-break:break-word;overflow-wrap:anywhere;">{{.}}</td>
                          </tr>
                          {{- end}}
                        </table>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              {{- end}}
            </table>
          </td>
        </tr>
        <tr>
          <td class="footer muted" style="padding:20px 41px 0;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;font-size:12px;line-height:18px;color:#737373;text-align:left;">{{.SentAt}}&nbsp;&nbsp;·&nbsp;&nbsp;Sent by relay</td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
