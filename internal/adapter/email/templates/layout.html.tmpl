<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark"><meta name="supported-color-schemes" content="light dark"><title>{{.Subject}}</title>
<script type="application/ld+json">{{.LinkedData}}</script>
<style>
@media (prefers-color-scheme: dark) {
  .bg { background:#16181b !important; }
  .ink { color:#e6e8eb !important; }
  .muted { color:#9ba3ad !important; }
  .faint { color:#6e7681 !important; }
  .rule { border-color:#2d3136 !important; }
  .panel { background:#1d2024 !important; border-color:#2d3136 !important; }
}
@media (max-width:600px) { .pad { padding:32px 20px !important; } }
</style></head>
<body class="bg" style="margin:0;padding:0;background:#ffffff;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">{{.Summary}}</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="bg" style="background:#ffffff;">
<tr><td align="center"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;">
<tr><td class="pad" style="padding:48px 32px;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
<p class="ink" style="margin:0;font-size:22px;line-height:1.3;font-weight:650;color:#1f2328;letter-spacing:-0.01em;"><span style="color:{{if .Calm}}#2f7d4f{{else}}#c4302b{{end}};font-size:15px;vertical-align:3px;">&#9679;</span>&nbsp; {{.Headline}}</p>
{{- with .Project}}
<p class="muted" style="margin:6px 0 0 0;font-size:14px;line-height:1.4;color:#59636e;">{{.}}</p>
{{- end}}
<p class="ink" style="margin:24px 0 0 0;font-size:15px;line-height:1.6;color:#1f2328;">{{range .Body}}{{if .Bold}}<b>{{breakable .Text}}</b>{{else}}{{.Text}}{{end}}{{end}}</p>
{{- with .Timeline}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:28px;"><tr>
{{- range .Ticks}}<td style="width:10px;padding:0 3px 0 0;"><div style="width:7px;height:22px;border-radius:2px;background:#c4302b;"></div></td>{{end}}
{{- with .Hidden}}<td class="muted" style="width:1%;padding:0 0 0 3px;font-size:12px;line-height:22px;color:#59636e;white-space:nowrap;">+{{.}}</td>{{end}}
{{- if .Recovered}}<td style="padding:0 0 0 6px;"><div style="height:4px;border-radius:2px;background:#2f7d4f;"></div></td>
{{- else}}<td style="padding:0 0 0 6px;"><div class="rule" style="height:0;border-top:2px dashed #e4e7eb;"></div></td>
{{- end}}</tr></table>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:8px;"><tr>
<td class="faint" style="font-size:12px;color:#8b949e;">{{.Start}}</td>
<td class="faint" align="right" style="font-size:12px;color:#8b949e;">{{.End}}</td></tr></table>
{{- end}}
{{- with .Failure}}
<div class="panel" style="margin-top:24px;padding:14px 16px;background:#f6f7f9;border:1px solid #e4e7eb;border-radius:8px;">
{{- with .Code}}
<p class="ink" style="margin:0;font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;font-size:13px;font-weight:600;color:#1f2328;">{{.}}</p>
{{- end}}
{{- with .Message}}
<p class="muted" style="margin:6px 0 0 0;font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;font-size:12.5px;line-height:1.55;color:#59636e;white-space:pre-wrap;word-break:break-word;">{{.}}</p>
{{- end}}</div>
{{- end}}
{{- with .Rows}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:28px;border-collapse:collapse;">
{{- range .}}<tr><td class="muted rule" style="padding:9px 0;width:128px;font-size:14px;color:#59636e;border-top:1px solid #e4e7eb;vertical-align:top;">{{.Label}}</td><td class="ink rule" style="padding:9px 0;font-size:14px;color:#1f2328;border-top:1px solid #e4e7eb;vertical-align:top;">
{{- if .Mono}}<span style="font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;font-size:13px;">{{breakable .Value}}</span>{{else}}{{.Value}}{{end -}}
</td></tr>{{end}}</table>
{{- end}}
<p class="faint" style="margin:36px 0 0 0;font-size:12px;line-height:1.5;color:#8b949e;">{{.Footer}}</p></td></tr></table></td></tr></table></body></html>
